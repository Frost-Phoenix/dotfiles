[init]
	defaultBranch = main
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[pull]
	ff = only
    rebase = true
[fetch]
    prune = true
[rebase]
    autoStash = true
[color]
	ui = true

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = gruvbox-dark
[interactive]
	diffFilter = delta --color-only

[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@github.com:frost-phoenix/"]
	insteadOf = fp:
